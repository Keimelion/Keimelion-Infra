{
	# No ACME: TLS is terminated by the Synology reverse proxy for keimelion.app.
	auto_https off

	# The NAS reverse proxy is the only client of the public hostnames: trust its
	# X-Forwarded-For, read right to left (strict) so the client IP is the first address
	# not added by the NAS. A client sending its own X-Forwarded-For cannot choose it.
	servers {
		trusted_proxies static 192.168.1.100
		trusted_proxies_strict
		client_ip_headers X-Forwarded-For
	}
}

# The API rate-limits by X-Forwarded-For: pass it the client IP alone (without this, every
# visitor arrived as the NAS and shared one bucket).
(api_upstream) {
	reverse_proxy api:3000 {
		header_up X-Forwarded-For {client_ip}
	}
}

# The landing rate-limits on the leftmost X-Forwarded-For value and forwards it to the API: pass
# it the client IP alone, otherwise a visitor can choose that value and get around the limits.
(landing_upstream) {
	reverse_proxy landing:3002 {
		header_up X-Forwarded-For {client_ip}
	}
}

# The NAS forwards plain HTTP here too (port 80 stays open for Let's Encrypt): redirect it
# to HTTPS, told apart by the X-Forwarded-Proto the NAS sets.
(https_only) {
	@plain_http header X-Forwarded-Proto http
	redir @plain_http https://{host}{uri} permanent
	header Strict-Transport-Security "max-age=31536000"
}

# Landing only (the Backoffice sets its own in next.config.ts). Every landing script is a
# same-origin file, so scripts need no 'unsafe-inline'; styles keep it for the style attributes
# and the ClientRouter view transitions.
(landing_security_headers) {
	header {
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; manifest-src 'self'; form-action 'self'; frame-ancestors 'none'; base-uri 'self'; object-src 'none'"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), browsing-topics=()"
		Cross-Origin-Opener-Policy "same-origin"
	}
}

# -----------------------------------------------------------------------------
# Public hostnames
# Flow: Cloudflare DNS → box :443 → NAS reverse proxy (TLS, Let's Encrypt)
#       → http://192.168.1.102:80 → here, routed by Host.
# -----------------------------------------------------------------------------

http://keimelion.app {
	log
	import https_only
	import landing_security_headers
	import landing_upstream
}

# One canonical URL: www redirects to the apex.
http://www.keimelion.app {
	log
	redir https://keimelion.app{uri} permanent
}

http://admin.keimelion.app {
	log
	import https_only
	reverse_proxy back:3001
}

http://api.keimelion.app {
	log
	import https_only
	handle_path /uploads/* {
		root * /srv/uploads
		header Cross-Origin-Resource-Policy "cross-origin"
		header Cache-Control "public, max-age=3600"
		file_server
	}
	import api_upstream
}
