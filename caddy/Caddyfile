{
	# No ACME: TLS is terminated by the Synology reverse proxy for *.zalbani.dev
	# (and nothing for the LAN *.keimelion.local, plain HTTP by design).
	auto_https off
}

# -----------------------------------------------------------------------------
# Public hostnames
# Flow: Cloudflare DNS → box :443 → NAS reverse proxy (TLS, Let's Encrypt)
#       → http://192.168.1.102:80 → here, routed by Host.
# -----------------------------------------------------------------------------

http://keimelion.zalbani.dev {
	log
	reverse_proxy landing:3002
}

http://admin.keimelion.zalbani.dev {
	log
	reverse_proxy back:3001
}

http://api.keimelion.zalbani.dev {
	log
	handle_path /uploads/* {
		root * /srv/uploads
		header Cross-Origin-Resource-Policy "cross-origin"
		header Cache-Control "public, max-age=3600"
		file_server
	}
	reverse_proxy api:3000
}

# -----------------------------------------------------------------------------
# LAN hostnames (plain HTTP via /etc/hosts, kept for debug and tunnel fallback)
# -----------------------------------------------------------------------------

http://keimelion.local {
	reverse_proxy landing:3002
}

http://admin.keimelion.local {
	reverse_proxy back:3001
}

http://api.keimelion.local {
	handle_path /uploads/* {
		root * /srv/uploads
		header Cross-Origin-Resource-Policy "cross-origin"
		header Cache-Control "public, max-age=3600"
		file_server
	}
	reverse_proxy api:3000
}

# Direct IP fallback for a LAN machine without /etc/hosts entries.
http://192.168.1.102 {
	redir http://keimelion.local{uri} permanent
}
