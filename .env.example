# =============================================================================
# Keimelion — variables d'environnement du serveur home
# Copier en .env (jamais commité) puis remplacer les valeurs.
# =============================================================================

# -----------------------------------------------------------------------------
# Postgres
# -----------------------------------------------------------------------------
POSTGRES_USER=keimelion
# Générer avec : openssl rand -hex 32
# (hex plutôt que base64 : le mot de passe est injecté dans DATABASE_URL, où
#  "/", "+" et "=" casseraient le parsing de l'URL)
POSTGRES_PASSWORD=changeme
POSTGRES_DB=keimelion

# -----------------------------------------------------------------------------
# Ports exposés sur l'hôte (0.0.0.0). Postgres reste sur 127.0.0.1:5432.
# -----------------------------------------------------------------------------
API_PORT=3000
BACK_PORT=3001
LANDING_PORT=3002

# -----------------------------------------------------------------------------
# URL publique de l'API, vue depuis le NAVIGATEUR (pas depuis Docker).
# Injectée au BUILD dans le back-office (NEXT_PUBLIC_API_URL) et la landing
# (PUBLIC_API_BASE_URL) : la changer impose un `docker compose up -d --build`.
# En LAN : http://<IP-du-serveur>:3000 — plus tard : https://api.<domaine>
# -----------------------------------------------------------------------------
PUBLIC_API_URL=http://192.168.1.102:3000

# -----------------------------------------------------------------------------
# API (Keimelion-API, cf. src/config/env.ts)
# -----------------------------------------------------------------------------
# development | production | test
NODE_ENV=production

# Secret de signature des JWT (min 32 caractères). Générer avec : openssl rand -base64 48
JWT_SECRET=changeme-at-least-32-characters-long-random
# Durée de vie de l'access token (format jose : 15m, 7d...)
JWT_EXPIRES_IN=7d
# Durée de vie du refresh token en secondes (min 3600, défaut 30 jours)
REFRESH_TOKEN_EXPIRES_IN=2592000

# Origines autorisées par CORS : TOUTES les origines des front-ends qui appellent l'API depuis le navigateur
# (schéma + hôte + port, sans slash final), séparées par des virgules. Ex. LAN :
# CORS_ORIGINS=http://192.168.1.102:3001,http://192.168.1.102:3002
CORS_ORIGINS=http://192.168.1.102:3001

# URL de base de l'API, utilisée pour construire des liens (emails...)
APP_URL=http://192.168.1.102:3000

# Rate limiting global : nb de requêtes max par fenêtre (ms)
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=900000
# Rate limiting dédié à POST /v1/feedback
FEEDBACK_RATE_LIMIT_PER_MINUTE=5
FEEDBACK_RATE_LIMIT_PER_HOUR=20

# Coût bcrypt pour le hash des mots de passe
BCRYPT_ROUNDS=12
# Durée de validité du lien de vérification d'email (heures)
EMAIL_VERIFY_TOKEN_TTL_HOURS=24

# Email transactionnel (Resend). Optionnel : vide = pas d'envoi d'email.
EMAIL_API_KEY=
EMAIL_FROM=noreply@keimelion.com

# Jobs de nettoyage internes (ms, min 60000)
JWT_CLEANUP_INTERVAL_MS=3600000
REFRESH_TOKEN_CLEANUP_INTERVAL_MS=3600000
USER_HARD_DELETE_INTERVAL_MS=3600000
# Délai avant purge définitive d'un compte supprimé (jours)
USER_HARD_DELETE_GRACE_DAYS=30

# Rafraîchissement quotidien des taux de change (BCE, sans clé API)
FX_REFRESH_ENABLED=true
FX_REFRESH_INTERVAL_MS=86400000
FX_PROVIDER_URL=https://www.ecb.europa.eu/stats/eurofxref/eurofxref-daily.xml

# Uploads d'images. Le dossier est un volume persistant (./data/uploads).
# NB : en NODE_ENV=production l'API ne sert PAS /uploads/* (prévu pour être servi
# par le reverse proxy) — à brancher quand Caddy sera en place.
UPLOADS_MAX_SIZE_BYTES=10000000
UPLOADS_PUBLIC_BASE_URL=http://192.168.1.102:3000/uploads
