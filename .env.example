# =============================================================================
# Keimelion — home server environment variables
# Copy to .env (never committed), then replace the values.
# =============================================================================

# -----------------------------------------------------------------------------
# Postgres
# -----------------------------------------------------------------------------
POSTGRES_USER=keimelion
# Generate with: openssl rand -hex 32
# (hex rather than base64: the password is injected into DATABASE_URL, where
#  "/", "+" and "=" would break URL parsing)
POSTGRES_PASSWORD=changeme
POSTGRES_DB=keimelion

# -----------------------------------------------------------------------------
# Debug ports, bound to 127.0.0.1 on the host (reach them through an SSH tunnel).
# The LAN entry point is Caddy (CADDY_PORT). Postgres stays on 127.0.0.1:5432.
# -----------------------------------------------------------------------------
API_PORT=3000
BACK_PORT=3001
LANDING_PORT=3002
# POSTGRES_PORT=5432
# Caddy's host port, the NAS reverse proxy target: 8080 for the pre-prod, 80 (default) for
# the production
CADDY_PORT=8080

# -----------------------------------------------------------------------------
# Production stack only (docs/runbook.md "Production stack"). The pre-prod leaves these unset.
# -----------------------------------------------------------------------------
# Wins over `name:` in docker-compose.yml: containers, network, volumes and images
# COMPOSE_PROJECT_NAME=keimelion-prod
# Caddy's host port (80, the default: remove CADDY_PORT above) and its config folder
# CADDY_CONFIG_DIR=./caddy-prod
# Names of the systemd units and of the sudoers file, and their schedule (scripts/backup/install.sh)
# BACKUP_UNIT_PREFIX=keimelion-prod
# BACKUP_ON_CALENDAR=*-*-* 00/6:45:00
# VERIFY_ON_CALENDAR=Sun *-*-* 05:30:00

# -----------------------------------------------------------------------------
# Public API URL, as seen from the BROWSER (not from Docker).
# Injected at BUILD time into the back-office (NEXT_PUBLIC_API_URL) and the landing
# (PUBLIC_API_BASE_URL): changing it requires `docker compose up -d --build`.
# Public hostname (via NAS reverse proxy + Let's Encrypt): https://api.keimelion.zalbani.dev
# LAN debug alternative:                                   http://api.keimelion.local
# -----------------------------------------------------------------------------
PUBLIC_API_URL=https://api.keimelion.zalbani.dev

# -----------------------------------------------------------------------------
# API (Keimelion-API, see src/config/env.ts)
# -----------------------------------------------------------------------------
# development | production | test
NODE_ENV=production

# JWT signing secret (min 32 characters). Generate with: openssl rand -base64 48
JWT_SECRET=changeme-at-least-32-characters-long-random
# Access token lifetime (jose format: 15m, 7d...)
JWT_EXPIRES_IN=7d
# Refresh token lifetime in seconds (min 3600, default 30 days)
REFRESH_TOKEN_EXPIRES_IN=2592000

# CORS allowed origins: ALL front-end origins that call the API from the browser
# (scheme + host + port, no trailing slash), comma-separated.
# LAN debug alternative: http://admin.keimelion.local,http://keimelion.local
CORS_ORIGINS=https://admin.keimelion.zalbani.dev,https://keimelion.zalbani.dev

# API base URL, used to build links (emails...)
APP_URL=https://api.keimelion.zalbani.dev

# Global rate limiting: max requests per window (ms)
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=900000
# Dedicated rate limiting for POST /v1/feedback
FEEDBACK_RATE_LIMIT_PER_MINUTE=5
FEEDBACK_RATE_LIMIT_PER_HOUR=20

# bcrypt cost for password hashing
BCRYPT_ROUNDS=12
# Email verification link validity (hours)
EMAIL_VERIFY_TOKEN_TTL_HOURS=24

# Transactional email. In production, a send fails with an error log if a value is empty.
# EMAIL_PROVIDER selects the API mail adapter (default: resend).
EMAIL_PROVIDER=resend
EMAIL_API_KEY=
EMAIL_FROM=noreply@keimelion.app

# Internal cleanup jobs (ms, min 60000)
JWT_CLEANUP_INTERVAL_MS=3600000
REFRESH_TOKEN_CLEANUP_INTERVAL_MS=3600000
USER_HARD_DELETE_INTERVAL_MS=3600000
# Delay before a deleted account is permanently purged (days)
USER_HARD_DELETE_GRACE_DAYS=30

# Daily exchange-rate refresh (ECB, no API key needed)
FX_REFRESH_ENABLED=true
FX_REFRESH_INTERVAL_MS=86400000
FX_PROVIDER_URL=https://www.ecb.europa.eu/stats/eurofxref/eurofxref-daily.xml

# Image uploads. The folder is a persistent volume (./data/uploads, must be owned by uid 1000).
# NB: with NODE_ENV=production the API does NOT serve /uploads/* — Caddy serves them
# from data/uploads (see caddy/Caddyfile).
UPLOADS_MAX_SIZE_BYTES=10000000
UPLOADS_PUBLIC_BASE_URL=https://api.keimelion.zalbani.dev/uploads

# -----------------------------------------------------------------------------
# Backups (scripts/backup/, see docs/backup.md). Not read by the containers.
# -----------------------------------------------------------------------------
# Local restic repository, work dir and cache (created by scripts/backup/install.sh)
BACKUP_ROOT=/var/backups/keimelion
# restic encryption key, generated by scripts/backup/init-repos.sh.
# KEEP A COPY IN THE PASSWORD MANAGER: without it no backup can be read.
RESTIC_PASSWORD_FILE=/home/zalbani/keimelion-integration/Keimelion-Infra/secrets/restic-password
# Off-site copy (Synology NAS over SFTP, host alias defined in ~/.ssh/config).
# Empty = local only (the scheduled backup then only warns).
RESTIC_OFFSITE_REPOSITORY=sftp:keimelion-nas:/keimelion-backup/restic
# restic forget policy, applied per tag (scheduled / pre-deploy / pre-restore / manual)
BACKUP_RETENTION=--keep-last 4 --keep-daily 14 --keep-weekly 8 --keep-monthly 12
# Restore test: fail if the latest snapshot is older than this, share of the data read by `restic check`
BACKUP_MAX_AGE_HOURS=12
BACKUP_VERIFY_READ_SUBSET=10%
# Dead man's switch ping URLs, empty = no alerting. Either an Uptime Kuma push monitor
# (http://<kuma>/api/push/<token>, query string ignored) or Healthchecks.io (https://hc-ping.com/<uuid>).
#   backup: 6 h + 1 h grace (Kuma heartbeat 25200 s) — verify: 7 d + 1 d (Kuma heartbeat 691200 s)
HC_BACKUP_URL=
HC_VERIFY_URL=
