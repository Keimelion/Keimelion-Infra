# Restores the snapshot recorded by keimelion-db-backup@<instance> (instance: pre-deploy-api),
# run by the deploy rollback when the previous release is unhealthy on the migrated schema.
# Installed by scripts/backup/install.sh — edit here, then rerun it.
[Unit]
Description=Keimelion restore of the %i snapshot
Documentation=file://@INFRA_DIR@/docs/runbook.md
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
User=@BACKUP_USER@
ExecStart=@INFRA_DIR@/scripts/backup/db-restore.sh --last %i --yes
TimeoutStartSec=30min
NoNewPrivileges=yes
ProtectSystem=full
