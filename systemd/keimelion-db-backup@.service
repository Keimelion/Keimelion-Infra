# Keimelion backup, one instance per restic tag: @scheduled (timer), @pre-deploy (deploy
# workflow), @manual. Installed by scripts/backup/install.sh — edit here, then rerun it.
[Unit]
Description=Keimelion backup (%i)
Documentation=file://@INFRA_DIR@/docs/backup.md
After=docker.service network-online.target
Wants=network-online.target
Requires=docker.service

[Service]
Type=oneshot
User=@BACKUP_USER@
ExecStart=@INFRA_DIR@/scripts/backup/db-backup.sh %i
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
TimeoutStartSec=1h
NoNewPrivileges=yes
ProtectSystem=full
