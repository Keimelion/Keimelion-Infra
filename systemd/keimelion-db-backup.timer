# Every 6 hours (RPO 6h). Persistent: a run missed while the server was off happens at boot.
[Unit]
Description=Keimelion scheduled backup

[Timer]
OnCalendar=@BACKUP_ON_CALENDAR@
RandomizedDelaySec=5min
Persistent=true
Unit=@UNIT_PREFIX@-db-backup@scheduled.service

[Install]
WantedBy=timers.target
